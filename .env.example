# Firebase service account (Firebase console → Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the whole key including the BEGIN/END lines. Keep the \n characters.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Password for /admin (your guest list page)
ADMIN_PASSWORD=choose-a-long-password
